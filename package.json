{
  "name": "aster-editor",
  "version": "0.2.0",
  "private": true,
  "description": "Éditeur de texte riche MIT, framework-agnostic, avec wrapper Angular et import Word",
  "license": "MIT",
  "author": "Joris Tremoulet",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "packages/core",
    "packages/word",
    "packages/ui",
    "packages/angular"
  ],
  "scripts": {
    "build": "npm run build -w packages/core -w packages/word -w packages/ui && ng build aster-angular",
    "test": "npm run test --workspaces --if-present && ng test aster-angular --watch=false && ng test demo --watch=false",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p apps/demo/tsconfig.app.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test",
    "demo": "ng serve demo",
    "demo:build": "ng build demo",
    "fixtures": "node scripts/generate-fixtures.ts",
    "playground": "node scripts/vanilla-playground.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "docx": "^9.10.0",
    "eslint": "^10.0.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
