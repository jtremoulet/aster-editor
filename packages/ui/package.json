{
  "name": "@aster-editor/ui",
  "version": "0.2.0",
  "description": "Toolbar vanilla et thèmes CSS pour Aster Editor",
  "license": "MIT",
  "author": "Joris Tremoulet",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./themes/*": "./themes/*"
  },
  "files": [
    "dist",
    "themes"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@aster-editor/core": ">=0.0.1"
  }
}
