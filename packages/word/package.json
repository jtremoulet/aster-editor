{
  "name": "@aster-editor/word",
  "version": "0.0.1",
  "description": "Import .docx et nettoyage du collage depuis Word et Google Docs pour Aster Editor",
  "license": "MIT",
  "author": "Joris Tremoulet",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "mammoth": "^1.13.0"
  },
  "peerDependencies": {
    "@aster-editor/core": ">=0.0.1",
    "@tiptap/core": "^3.31.4"
  }
}
